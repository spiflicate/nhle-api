# NHL API Client Environment Configuration
# Copy this file to .env and customize as needed

# Request timeout in milliseconds (default: 5000)
# NHLE_API_TIMEOUT=5000

# Language for API responses: 'en' or 'fr' (default: 'en')
# NHLE_API_LANGUAGE=en

# Logging level: 'silent', 'error', 'warn', 'info', 'debug' (default: 'warn')
# NHLE_API_LOGLEVEL=warn
