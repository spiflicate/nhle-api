{
   "$comment": "Paths scraped from nhl.com's bundles that aren't API endpoints the library should call, under \"*\" (every API), \"web\" (every api-web version), or one API: \"v1\", \"v2\", \"stats\". Keys are templates as the discovery report prints them; a key ending in * matches every template that starts with it. Each value says why it's ignored.",
   "*": {
      "/add": "Redux Toolkit action type",
      "/executeMutation": "RTK Query action type",
      "/executeQuery": "RTK Query action type",
      "/fulfilled": "Redux Toolkit action type",
      "/internalSubscriptions": "RTK Query slice name",
      "/invalidateTags": "RTK Query action type",
      "/invalidation": "RTK Query slice name",
      "/mutations": "RTK Query slice name",
      "/pending": "Redux Toolkit action type",
      "/queries": "RTK Query slice name",
      "/rejected": "Redux Toolkit action type",
      "/remove": "Redux Toolkit action type",
      "/removeAll": "Redux Toolkit action type",
      "/resetApiState": "RTK Query action type",
      "/subscriptions": "RTK Query slice name",
      "/goalies": "site route, matched against the page URL",
      "/skaters": "site route, matched against the page URL",
      "/teams": "site route, matched against the page URL"
   },
   "web": {
      "/config": "RTK Query slice name (api/config)",
      "/draft/prospects*": "site route (nhl.com/draft/prospects)",
      "/draft/tracker*": "site route (nhl.com/draft/tracker)",
      "/events/*": "site route (nhl.com/events), draft coverage pages",
      "/gamecenter/{}-vs-{}/{}/{}": "site route (nhl.com/gamecenter/tor-vs-mtl/...)",
      "/gamecenter/{}/{}/{}/{}/{}": "site route (nhl.com/gamecenter/{teams}/{yyyy}/{mm}/{dd}/{id})",
      "/gamecenter/{}/{}/{}/{}/{}/{}": "site route (nhl.com/gamecenter/.../{tab})",
      "/how-to-watch/{}": "site route",
      "/info/watch-nhl-zipcode-blackout-lookup": "site route",
      "/list": "site route suffix (nhl.com/schedule/{date}/list)",
      "/logos/*": "assets.nhle.com image folder",
      "/mugs/*": "assets.nhle.com image folder",
      "/news/{}": "site route",
      "/nhl-edge*": "site routes (nhl.com/nhl-edge/...)",
      "/nhl/Coaches-latest/": "assets.nhle.com image folder",
      "/nhl/GMs-latest/": "assets.nhle.com image folder",
      "/nhl_d3_widgets/config.json": "nhl.com widget config, not api-web",
      "/now": "suffix the site appends to Edge paths the library calls with a season",
      "/page-builder-text-editor": "CMS component name",
      "/page/": "CMS path",
      "/png/64x64/": "assets.nhle.com image folder",
      "/scores": "site route",
      "/scores/{}": "site route (nhl.com/scores/{date})",
      "/standings/{}/{}": "site route (nhl.com/standings/{date}/{view})",
      "/stats/{}*": "site route (nhl.com/{team}/stats/{season}/{gameType})",
      "/stories": "site route",
      "/streaming/web_stream_config.json": "streaming player config, not api-web",
      "/svg/": "assets.nhle.com image folder",
      "/textures/*": "assets.nhle.com image folder",
      "/video/*": "site route (nhl.com/video/...)",
      "/videos": "site route"
   },
   "stats": {
      "/content/module/{}": "CMS content API under /site/api, not the Stats API",
      "/error": "Redux action type",
      "/mobile*": "site route (nhl.com/stats/mobile/...)",
      "/stats/": "site route",
      "/stats/static/": "the app's own asset path",
      "/stats{}": "site route"
   }
}
