{
   "name": "nhle-api",
   "version": "0.5.0",
   "description": "A modern NHL API wrapper written in TypeScript.",
   "main": "lib/index.js",
   "module": "lib/index.mjs",
   "types": "lib/index.d.ts",
   "type": "module",
   "exports": {
      ".": {
         "types": "./lib/index.d.ts",
         "require": "./lib/index.cjs",
         "import": "./lib/index.js"
      }
   },
   "files": [
      "lib",
      "src"
   ],
   "scripts": {
      "build": "bunx tsup src/index.ts --format esm,cjs --dts --sourcemap --outDir lib --clean",
      "dev": "bunx tsup src/index.ts --format esm,cjs --dts --sourcemap --outDir lib --watch",
      "typecheck": "bunx tsc --noEmit",
      "test": "bun test",
      "test:watch": "bun test --watch",
      "prepublishOnly": "bun run typecheck && bun run build",
      "wadl:check": "bun scripts/check-wadl.ts"
   },
   "keywords": [
      "nhl",
      "api",
      "edge",
      "stats",
      "hockey",
      "sports",
      "typescript"
   ],
   "author": "jbru",
   "license": "MIT",
   "repository": {
      "type": "git",
      "url": "https://github.com/spiflicate/nhle-api.git"
   },
   "devDependencies": {
      "@biomejs/biome": "2.3.4",
      "@types/bun": "^1.3.1",
      "msw": "^2.12.0",
      "tsup": "^8.5.0",
      "typescript": "^5.9.3"
   },
   "dependencies": {
      "arktype": "^2.1.25"
   }
}
